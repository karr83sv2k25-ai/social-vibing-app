rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // HELPER FUNCTIONS
    // =============================================================================
    
    // Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user ID matches
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if user is admin (supports both role field and isAdmin boolean)
    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && 
             (userData.role == 'admin' || userData.isAdmin == true);
    }
    
    // Check if user is creator
    function isCreator() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator';
    }

    // =============================================================================
    // AMINO-STYLE ROLE HELPERS
    // =============================================================================

    // Single document read helper — Firebase caches get() per path per request,
    // so all role checks below share one read against the community document.
    function getCommunityDoc(communityId) {
      return get(/databases/$(database)/documents/communities/$(communityId)).data;
    }

    // Check if caller is the community owner (creatorId)
    function isCommunityOwner(communityId) {
      return isSignedIn() &&
        getCommunityDoc(communityId).creatorId == request.auth.uid;
    }

    // Any community staff (owner / leader / curator / adminIds member).
    // Guards against missing array fields — old communities may not have leaders/curators.
    function isCommunityStaff(communityId) {
      let comm = getCommunityDoc(communityId);
      return isSignedIn() && (
        comm.creatorId == request.auth.uid ||
        ('leaders'  in comm && comm.leaders.hasAny([request.auth.uid]))  ||
        ('curators' in comm && comm.curators.hasAny([request.auth.uid])) ||
        ('adminIds' in comm && comm.adminIds.hasAny([request.auth.uid]))
      );
    }

    // Leader or above (can strike, ban, manage titles, etc.) — single cached doc read
    function isLeaderOrAbove(communityId) {
      let comm = getCommunityDoc(communityId);
      return isAdmin() || (isSignedIn() && (
        comm.creatorId == request.auth.uid ||
        ('leaders' in comm && comm.leaders.hasAny([request.auth.uid])) ||
        ('adminIds' in comm && comm.adminIds.hasAny([request.auth.uid]))
      ));
    }

    // Check if caller is currently struck (view-only) – used to block writes.
    // Also respects strikeExpiresAt so expired temporary strikes don't permanently block.
    function isStruck() {
      let userData = exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
      let struck = userData.get('isStruck', false) == true;
      let expiresAt = userData.get('strikeExpiresAt', null);
      // Still blocked if struck AND (permanent OR not yet expired)
      return isSignedIn() && struck && (expiresAt == null || request.time < expiresAt);
    }

    // Check if caller is banned.
    // Also respects banExpiresAt so expired temporary bans don't permanently block.
    function isBanned() {
      let userData = exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
      let banned = userData.get('isBanned', false) == true;
      let expiresAt = userData.get('banExpiresAt', null);
      // Still blocked if banned AND (permanent OR not yet expired)
      return isSignedIn() && banned && (expiresAt == null || request.time < expiresAt);
    }

    // Block all writes from struck or banned users
    function canWrite() {
      return isSignedIn() && !isStruck() && !isBanned();
    }

    // Check if caller is struck specifically in a community (communities/{id}/strikes/{uid})
    function isCommunityStruck(communityId) {
      let strikePath = /databases/$(database)/documents/communities/$(communityId)/strikes/$(request.auth.uid);
      let strikeData = exists(strikePath) ? get(strikePath).data : {};
      let active = strikeData.get('isActive', false) == true;
      let expiresAt = strikeData.get('strikeExpiresAt', null);
      return isSignedIn() && active && (expiresAt == null || request.time < expiresAt);
    }

    // Community write gate: global checks + community strike check
    function canWriteInCommunity(communityId) {
      return canWrite() && !isCommunityStruck(communityId);
    }

    // Ensure no email fields are stored in community-visible documents
    function hasNoEmailFields() {
      return !request.resource.data.keys().hasAny(['email', 'user_email', 'userEmail']);
    }
    
    // =============================================================================
    // USERS COLLECTION
    // =============================================================================
    
    match /users/{userId} {
      // Users can read their own profile, others can read public fields
      allow read: if isSignedIn();
      
      // Users can create their own profile during signup (email must NOT be in this document)
      allow create: if isSignedIn() && isOwner(userId)
                      && !request.resource.data.keys().hasAny(['email', 'user_email']);
      
      // Users can update their own profile, BUT NEVER wallet fields or email directly
      allow update: if isSignedIn() && isOwner(userId)
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'coins', 
                        'diamonds',
                        'wallet',
                        'ownedProducts',
                        'earningsBalance',
                        'totalEarnings',
                        'email',
                        'user_email'
                      ]);
      
      // Allow activeCustomizations updates (frames/bubbles from marketplace)
      allow update: if isSignedIn() && isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'activeCustomizations'
                      ]);
      
      // Admins can update user moderation fields (full)
      allow update: if isAdmin() && 
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isBanned', 'banType', 'banReason', 'bannedAt', 
                                  'banExpiresAt', 'bannedBy', 'isSuspended', 
                                  'suspendedReason', 'suspendedAt', 'suspendedBy',
                                  'accountStatus', 'role',
                                  // Strike fields
                                  'isStruck', 'strikeCount', 'lastStrikeAt', 'strikeExpiresAt',
                                  'strikeReason', 'struckBy', 'struckByCommunityId',
                                  'canPost', 'canMessage', 'canFollow', 'canCreateContent',
                                  // Message moderation
                                  'messagesDisabledAt', 'messagesDisabledBy', 'messagesDisabledReason',
                                  // Verification fields
                                  'verificationStatus', 'isVerified', 'verifiedAt', 'verifiedBy',
                                  'rejectedAt', 'rejectedBy', 'rejectionReason',
                                  'revokedAt', 'revokedBy',
                                  // Unban tracking
                                  'unbannedAt', 'unbannedBy',
                                  // Warning fields
                                  'warningsCount', 'lastWarning', 'lastWarningDate',
                                  'warnedAt', 'warnedBy',
                                  'updatedAt']);

      // Leaders (and above) can strike/unstrike, disable messages, warn, kick, ban users
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['isStruck', 'strikeCount', 'lastStrikeAt', 'strikeExpiresAt',
                                  'strikeReason', 'struckBy', 'struckByCommunityId',
                                  'canPost', 'canMessage', 'canFollow', 'canCreateContent',
                                  'messagesDisabledAt', 'messagesDisabledBy', 'messagesDisabledReason',
                                  // Warning fields (compatible with admin app)
                                  'warningsCount', 'lastWarning', 'lastWarningDate',
                                  'warnedAt', 'warnedBy',
                                  // Ban fields (community leader can ban)
                                  'isBanned', 'banReason', 'bannedAt', 'bannedBy', 'banExpiresAt',
                                  'updatedAt']);
      
      // Users can update their own membership tier
      allow update: if isSignedIn() && isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['membershipTier', 'membershipExpiresAt']);
      
      // Users can update counters (followers, following)
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['followersCount', 'followingCount']);

      // Any signed-in user can increment report stats on another user's profile
      // (written by the reporting system when a report is submitted)
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reportsReceived', 'lastReportedAt']);
      
      // User boost usage tracking
      match /boostUsage/{usageId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }

      // ── Private user data (email, phone, etc.) ─────────────────────────
      // Only the account owner and admins may read or write this subcollection.
      // Email MUST be stored here — not in the parent users/{userId} document.
      match /private/{privateDoc} {
        allow read:   if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin());
      }
      
      // User payments history
      match /payments/{paymentId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
      }
      
      // User notifications
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn();
        allow update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }

      // Daily Rewards subcollection — own user only
      match /dailyRewards/{rewardId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
      }

      // Streak Data subcollection — own user only
      match /streakData/{docId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && isOwner(userId);
      }

      // Friend Invites subcollection — owner can read/write;
      // invited user can update status (accept/reject)
      match /invites/{inviteId} {
        allow read: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isSignedIn() && (
          isOwner(userId) ||
          resource.data.invitedUserId == request.auth.uid
        );
      }
    }
    
    // =============================================================================
    // CONTENT COLLECTION (Videos/Content Items)
    // =============================================================================
    
    match /content/{contentId} {
      // Anyone can read published content
      // Creators can read their own content (even if not published)
      allow read: if resource.data.status == 'published' || 
                    (isSignedIn() && resource.data.creatorId == request.auth.uid);
      
      // Creators can create content
      allow create: if isSignedIn() && 
                      (isCreator() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator') &&
                      request.resource.data.creatorId == request.auth.uid;
      
      // Creators can update their own content
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // Admins can moderate content
      allow update: if isAdmin() && 
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'isDeleted', 'deletedAt', 'deletedBy', 
                                  'deletionReason', 'moderationNotes']);
      
      // Anyone can update view count (for analytics)
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['viewCount', 'lastViewedAt']);
      
      // Creators can delete their own content
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // Admins can delete any content
      allow delete: if isAdmin();
    }
    
    // =============================================================================
    // STREAMS COLLECTION (Live Streams)
    // =============================================================================
    
    match /streams/{streamId} {
      // Anyone can read active/public streams
      // Creators can read their own streams (even if not active)
      allow read: if resource.data.status == 'active' || 
                    resource.data.visibility == 'public' ||
                    (isSignedIn() && resource.data.creatorId == request.auth.uid);
      
      // Creators can create streams
      allow create: if isSignedIn() && 
                      (isCreator() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator') &&
                      request.resource.data.creatorId == request.auth.uid;
      
      // Creators can update their own streams
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // Anyone can update viewer count (for live stats)
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['viewerCount', 'currentViewers', 'peakViewers']);
      
      // Creators can delete their own streams
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // Stream chat messages
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
                        request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
        allow delete: if isSignedIn() && 
                        (resource.data.senderId == request.auth.uid || isAdmin());
      }
      
      // Stream mutes (moderation)
      match /mutes/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
                        get(/databases/$(database)/documents/streams/$(streamId)).data.creatorId == request.auth.uid;
        allow delete: if isSignedIn() && 
                        get(/databases/$(database)/documents/streams/$(streamId)).data.creatorId == request.auth.uid;
      }
      
      // Stream viewers (for viewer count tracking)
      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && viewerId == request.auth.uid;
        allow update: if isSignedIn() && viewerId == request.auth.uid;
        allow delete: if isSignedIn() && viewerId == request.auth.uid;
      }
    }
    
    // =============================================================================
    // RECORDINGS COLLECTION (VOD - Video On Demand)
    // =============================================================================
    
    match /recordings/{recordingId} {
      // Anyone can read published/ready recordings
      // Creators can read their own recordings
      allow read: if resource.data.status == 'ready' || 
                    resource.data.visibility == 'public' ||
                    (isSignedIn() && resource.data.creatorId == request.auth.uid);
      
      // System/Cloud Functions create recordings
      allow create: if isSignedIn();
      
      // Creators can update their own recordings
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // System can update recording status (via Cloud Functions)
      allow update: if isSignedIn() &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'playbackUrl', 'thumbnailUrl', 'duration', 
                                  'processedAt', 'readyAt', 'failedAt', 'error']);
      
      // Creators can delete their own recordings
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      
      // Playback sessions (for analytics)
      match /sessions/{sessionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
                        request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
    
    // =============================================================================
    // CHAT MODERATION COLLECTIONS
    // =============================================================================
    
    match /chatBans/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // =============================================================================
    // ADMIN COLLECTIONS
    // =============================================================================
    
    // ── Advertisements (managed by admin panel) ─────────────────────────
    match /advertisements/{adId} {
      // Anyone can read ads (no auth needed for display)
      allow read: if true;
      // Only admins can create, update, or delete ads
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ── Blocked Content (admin-managed keyword blocklist) ───────────────
    match /blocked_content/{ruleId} {
      // Users can read blocked content rules (needed for client-side validation)
      allow read: if isSignedIn();
      // Only admins can manage blocked content rules
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ── Blocked Members (community-level bans) ──────────────────────────
    match /blocked_members/{entryId} {
      // Admins can do everything; community staff can read their community's blocked list
      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.communityId != null &&
                     isCommunityStaff(resource.data.communityId));
      // Leaders and above (or admins) can block members
      allow create: if isAdmin() ||
                      (isSignedIn() &&
                       request.resource.data.communityId != null &&
                       isLeaderOrAbove(request.resource.data.communityId));
      // Allow update by the same principals
      allow update: if isAdmin() ||
                      (isSignedIn() &&
                       resource.data.communityId != null &&
                       isLeaderOrAbove(resource.data.communityId));
      // Leaders and above (or admins) can unblock members
      allow delete: if isAdmin() ||
                      (isSignedIn() &&
                       resource.data.communityId != null &&
                       isLeaderOrAbove(resource.data.communityId));
    }

    // ── Join Requests (private community membership requests) ───────────
    match /join_requests/{requestId} {
      // Users can read their own requests; admins and community staff can read all
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
      );
      // Any signed-in user can create a join request
      allow create: if isSignedIn() &&
                      request.resource.data.userId == request.auth.uid;
      // Admins and community staff can approve/reject; user can cancel own
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
      );
      // Admins and community staff can delete; user can delete own
      allow delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        (resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
      );
    }
    
    // ── Management Records (admin audit trail) ──────────────────────────
    match /management_records/{recordId} {
      // Admins can read all; community staff can read their community's records
      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.communityId != null &&
                     isCommunityStaff(resource.data.communityId));
      // Only admins can create management records
      allow create: if isAdmin();
      // Management records are immutable
      allow update: if false;
      allow delete: if false;
    }
    
    // ── Reports (user-submitted, admin-managed) ────────────────────────
    match /reports/{reportId} {
      // Admins can read all reports; users can read reports they submitted;
      // community staff can read reports scoped to their community (communityId field set).
      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.reporterId == request.auth.uid) ||
                    (isSignedIn() &&
                      resource.data.communityId != null &&
                      isCommunityStaff(resource.data.communityId));
      // Any signed-in user can create a report
      allow create: if isSignedIn() &&
                      request.resource.data.reporterId == request.auth.uid;
      // Platform admins can update any report.
      // Community staff (owner / leader / curator) can update community-scoped reports
      // with the limited fields: status, actionTaken, communityReviewedBy,
      // communityReviewedAt, adminNotes, isResolved, updatedAt.
      allow update: if isAdmin() ||
                    (isSignedIn() &&
                      resource.data.communityId != null &&
                      isCommunityStaff(resource.data.communityId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'actionTaken', 'communityReviewedBy',
                                  'communityReviewedAt', 'adminNotes', 'isResolved', 'updatedAt']));
      // Only admins can delete reports
      allow delete: if isAdmin();
    }
    
    // ── Admin Actions (immutable action log from admin panel) ────────────
    match /admin_actions/{actionId} {
      // Only admins can read and create admin actions
      allow read: if isAdmin();
      allow create: if isAdmin();
      // Admin actions are immutable — never allow update or delete
      allow update: if false;
      allow delete: if false;
    }
    
    // =============================================================================
    // MODERATION LOGS (Amino-style audit trail)
    // =============================================================================
    match /moderationLogs/{logId} {
      // Single-document reads: admins always; staff only if the log belongs to their community.
      // resource.data is available for `get` (single-doc) but NOT for `list` (query).
      allow get: if isAdmin() ||
                   (isSignedIn() && resource.data.communityId != null &&
                    isCommunityStaff(resource.data.communityId));
      // Query / list: resource.data is unavailable at list-eval time, so we allow any
      // signed-in user here. The app always filters by communityId and the CommunityModerationScreen
      // enforces staff access before this query runs, so this is safe in practice.
      allow list: if isAdmin() || isSignedIn();
      // Any authenticated staff can create logs (service validates actor role)
      allow create: if isSignedIn();
      // Logs are immutable — never allow update or delete
      allow update: if false;
      allow delete: if false;
    }
    
    // =============================================================================
    // BOOST SYSTEM COLLECTIONS
    // =============================================================================
    
    match /boostTransactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid;
    }
    
    // =============================================================================
    // CREATOR STREAM KEYS (Secure)
    // =============================================================================
    
    match /creators/{creatorId}/streamKeys/{keyId} {
      allow read: if isSignedIn() && creatorId == request.auth.uid;
      allow create: if isSignedIn() && creatorId == request.auth.uid;
      allow update: if isSignedIn() && creatorId == request.auth.uid;
      allow delete: if isSignedIn() && creatorId == request.auth.uid;
    }
    
    // =============================================================================
    // MARKETPLACE COLLECTIONS
    // =============================================================================
    
    // Wallets - users can read their own.
    // Cloud Functions handle most writes; the check-in service also needs
    // client-side wallet access (creates wallet on first check-in, increments coins).
    match /wallets/{userId} {
      allow read: if isSignedIn();

      // Client may INITIALISE a wallet (first check-in path)
      allow create: if isSignedIn() && isOwner(userId);

      // Client may update coins + timestamp only (check-in reward path).
      // Covers both direct field updates and increment() operations.
      // All other financial mutations remain Cloud-Function-only.
      allow update: if isSignedIn() && isOwner(userId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['coins', 'updatedAt']);
    }
    
    // Transactions - users can only read their own
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Daily Rewards - users can only access their own
    match /dailyRewards/{rewardId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Ad Rewards - users can only access their own
    match /adRewards/{rewardId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Withdrawals - users can only access their own
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // =============================================================================
    // END MARKETPLACE COLLECTIONS
    // (products, orders, libraries, reviews are managed by Cloud Functions — see below)
    // =============================================================================
    
    // Audio calls collection
    match /audio_calls/{communityId}/rooms/{roomId} {
      // Allow authenticated users to create and read audio rooms
      allow create: if isSignedIn() &&
                      request.resource.data.createdBy == request.auth.uid;
      allow read: if isSignedIn();
      
      // Allow update if user is authenticated (for joining, leaving, updating status)
      allow update: if isSignedIn();
      
      // Allow delete if user is authenticated
      allow delete: if isSignedIn();
      
      // Chat messages in audio call rooms
      match /chat/{chatId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
    
    // Voice/Video Calls (both 1-on-1 and group calls)
    match /calls/{callId} {
      // Allow read if user is authenticated
      // For 1-on-1: caller or receiver
      // For group: anyone authenticated (they'll check groupId exists)
      allow read: if isSignedIn();
      
      // Allow create if user is the caller (callerId must match auth user)
      allow create: if isSignedIn() && 
                      request.resource.data.callerId == request.auth.uid;
      
      // Allow update if user is authenticated
      // This allows joining group calls and updating call status
      allow update: if isSignedIn();
      
      // Allow delete if user is authenticated and involved in the call
      allow delete: if isSignedIn();
      
      // Chat messages in calls
      match /chat/{chatId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
    
    // Communities collection
    match /communities/{communityId} {
      allow read: if true; // Allow public read for communities
      // Only staff or owner can update main community doc; creation by anyone signed in
      allow create: if isSignedIn();
      // Owner/admin: full update (including ownership transfer fields).
      // Staff (leaders/curators): any field EXCEPT core identity fields (creatorId).
      // Members: join/leave only (members[], memberIds[], memberCount, members_count, updatedAt).
      allow update: if isSignedIn() && (
        isCommunityOwner(communityId) || isAdmin() ||
        // adminIds members can do full updates (needed for transfer-admin flow)
        (isCommunityStaff(communityId) &&
          resource.data.get('adminIds', []).hasAny([request.auth.uid])) ||
        (isCommunityStaff(communityId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId'])) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberIds', 'memberCount', 'members_count', 'updatedAt'])
      );
      allow delete: if isCommunityOwner(communityId) || isAdmin();
      
      // Posts subcollection
      match /posts/{postId} {
        allow read: if true; // Allow public read for posts
        // Struck / banned users cannot create posts; email must not be stored
        allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
        // Post author can update; staff can moderate; email must not be added
        allow update: if hasNoEmailFields() && (
                         (isSignedIn() && resource.data.authorId == request.auth.uid)
                         || isCommunityStaff(communityId) || isAdmin()
                         // Any signed-in user can toggle likes or increment comment count
                         || (isSignedIn()
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['likes', 'likedBy', 'comments', 'commentsCount'])));
        allow delete: if isSignedIn() && 
                        (resource.data.authorId == request.auth.uid || 
                         get(/databases/$(database)/documents/communities/$(communityId)).data.uid == request.auth.uid
                         || isCommunityStaff(communityId) || isAdmin());
        
        // Comments subcollection
        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
          // Author can edit own comment; staff can soft-delete (isDeleted flag)
          allow update: if isSignedIn() && hasNoEmailFields() && (
                           resource.data.authorId == request.auth.uid ||
                           isCommunityStaff(communityId) || isAdmin()
                         );
          allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
        }
      }
      
      // Blogs subcollection
      match /blogs/{blogId} {
        allow read: if isSignedIn();
        allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
        allow update: if hasNoEmailFields() && (
                         (isSignedIn() && resource.data.authorId == request.auth.uid)
                         || isCommunityStaff(communityId) || isAdmin()
                         // Any signed-in user can toggle likes or increment comment count
                         || (isSignedIn()
                             && request.resource.data.diff(resource.data).affectedKeys()
                                  .hasOnly(['likes', 'likedBy', 'comments', 'commentsCount'])));
        allow delete: if isSignedIn() && 
                        (resource.data.authorId == request.auth.uid || 
                         get(/databases/$(database)/documents/communities/$(communityId)).data.uid == request.auth.uid
                         || isCommunityStaff(communityId) || isAdmin());
        
        // Comments subcollection for blogs
        match /comments/{commentId} {
          allow read: if isSignedIn();
          allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
          // Author can edit own comment; staff can soft-delete (isDeleted flag)
          allow update: if isSignedIn() && hasNoEmailFields() && (
                           resource.data.authorId == request.auth.uid ||
                           isCommunityStaff(communityId) || isAdmin()
                         );
          allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
        }
      }
      
      // Drafts subcollection
      match /drafts/{draftId} {
        allow read: if isSignedIn() && resource.data.authorId == request.auth.uid;
        allow create: if canWriteInCommunity(communityId);
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
      
      // Communities members subcollection (for member list within a community)
      match /communities_members/{memberId} {
        allow read: if true; // Allow public read for member count display
        allow create: if isSignedIn() && hasNoEmailFields();
        allow update: if isSignedIn() && hasNoEmailFields();
        allow delete: if isSignedIn();
      }

      // Members subcollection (community membership & nicknames)
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && hasNoEmailFields();
        allow update: if isSignedIn() && hasNoEmailFields() && (memberId == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
        allow delete: if isSignedIn() && (memberId == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
      }

      // ── Amino Role System Sub-collections ──────────────────────────────

      // Strikes: staff write, owner/leaders/admin can manage; users can read their own strike
      match /strikes/{userId} {
        allow read: if (isSignedIn() && userId == request.auth.uid) || isCommunityStaff(communityId) || isAdmin();
        allow write: if isLeaderOrAbove(communityId) || isAdmin();
      }

      // Bans: community-scoped bans (do NOT touch users/{uid}.isBanned — that is for platform-wide admin bans only)
      match /bans/{userId} {
        allow read: if (isSignedIn() && userId == request.auth.uid) || isCommunityStaff(communityId) || isAdmin();
        allow write: if isLeaderOrAbove(communityId) || isAdmin();
      }

      // Warnings: staff can read/write community-scoped warnings
      match /warnings/{warningId} {
        allow read: if isCommunityStaff(communityId) || isAdmin();
        allow create: if isCommunityStaff(communityId) || isAdmin();
        allow update: if false;
        allow delete: if isLeaderOrAbove(communityId) || isAdmin();
      }

      // Pending Promotions: read by the target user; write by owner/leaders/admin
      match /pendingPromotions/{userId} {
        allow read: if isSignedIn() && (userId == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
        allow create: if isLeaderOrAbove(communityId) || isAdmin();
        allow update: if (isSignedIn() && userId == request.auth.uid) || isAdmin();
        allow delete: if isLeaderOrAbove(communityId) || isAdmin();
      }

      // Member Titles: read by anyone, write by leaders/above
      match /memberTitles/{userId} {
        allow read: if true;
        allow write: if isLeaderOrAbove(communityId) || isAdmin();
      }
      
      // Groups subcollection
      match /groups/{groupId} {
        allow read: if isSignedIn();
        allow create: if canWriteInCommunity(communityId);
        // Staff can update group settings (lock, slowmode); members can update basic fields
        allow update: if isSignedIn();
        allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isCommunityStaff(communityId) || isAdmin());
        
        // Messages within a group
        match /messages/{messageId} {
          allow read: if isSignedIn();
          allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
          // Staff can soft-delete (update isDeleted); message authors can update their own
          allow update: if isSignedIn() && hasNoEmailFields() && (
            resource.data.senderId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isAdmin()
          );
          allow delete: if isSignedIn() && (
            resource.data.senderId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isAdmin()
          );
        }
        
        // Members within a group — staff can update (mute/unmute)
        match /members/{memberId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && hasNoEmailFields();
          allow update: if isSignedIn() && hasNoEmailFields() && (
            memberId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isAdmin()
          );
          allow delete: if isSignedIn() && (
            memberId == request.auth.uid ||
            isCommunityStaff(communityId) ||
            isAdmin()
          );
        }
      }
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
        allow update: if isSignedIn() && hasNoEmailFields();
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }

      // ── Check-ins subcollection (community leaderboard & streak system) ──
      // Any signed-in user may READ check-in docs (needed to render leaderboard).
      // Only the owning user may CREATE or UPDATE their own doc.
      // History sub-docs are immutable once written.
      match /checkIns/{checkInUserId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == checkInUserId;
        allow update: if isSignedIn() && request.auth.uid == checkInUserId;
        allow delete: if false;

        // Daily history entries – write-once, readable by owner
        match /history/{dateId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == checkInUserId;
          allow update: if false;  // immutable
          allow delete: if false;
        }
      }
    }
    
    // Community chats
    match /community_chats/{communityId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if canWriteInCommunity(communityId) && hasNoEmailFields();
      allow update: if isSignedIn() && hasNoEmailFields();
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }
    
    // Community members
    match /communities_members/{membershipId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && hasNoEmailFields();
      allow update: if isSignedIn() && hasNoEmailFields();
      allow delete: if isSignedIn();
    }
    
    // Helper function to check conversation participant (safer version)
    function isConversationParticipant(conversationId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    
    // Helper function to check conversation admin (safer version)
    function isConversationAdmin(conversationId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.admins;
    }
    
    // Private conversations (list of user's conversations)
    match /conversations/{conversationId} {
      // get: allow reading a single doc (resource==null when doc doesn't exist yet)
      allow get: if isSignedIn() &&
                   (resource == null || request.auth.uid in resource.data.participants);
      // list: allow collection queries where user is a participant
      allow list: if isSignedIn() &&
                    request.auth.uid in resource.data.participants;
      // FIXED: Allow create if user is in the new conversation's participants
      // Allow group creation with userSettings and unreadCount initialization
      allow create: if isSignedIn() && 
                      (request.auth.uid in request.resource.data.participants) &&
                      request.resource.data.participants is list &&
                      (
                        // 1-on-1 chat (simple validation)
                        request.resource.data.type == 'private' ||
                        // Group chat (creator must be in admins)
                        (request.resource.data.type == 'group' && 
                         request.auth.uid in request.resource.data.admins &&
                         request.auth.uid == request.resource.data.createdBy)
                      );
      allow update: if isSignedIn() && 
                      (request.auth.uid in resource.data.participants);
      allow delete: if isConversationAdmin(conversationId);
      
      // Messages within a conversation
      match /messages/{messageId} {
        // Allow read if user is signed in and conversation exists with user as participant
        allow read: if isConversationParticipant(conversationId);
        
        // Allow create if user is sender and either:
        // 1. Conversation exists and user is participant
        // 2. Conversation doesn't exist yet (first message/conversation creation)
        allow create: if isSignedIn() && 
                        request.resource.data.senderId == request.auth.uid &&
                        (
                          isConversationParticipant(conversationId) ||
                          !exists(/databases/$(database)/documents/conversations/$(conversationId))
                        );
        
        allow update: if isSignedIn() && 
                        (resource.data.senderId == request.auth.uid || 
                         isConversationParticipant(conversationId) ||
                         request.resource.data.keys().hasOnly(['status', 'reactions', 'deletedFor', 'isActive', 'closedAt', 'closedBy']));
        allow delete: if resource.data.senderId == request.auth.uid;
      }
    }
    
    // User presence
    match /user_presence/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId;
    }
    
    // Message drafts
    match /message_drafts/{userId}/conversations/{conversationId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Notification queue
    match /notification_queue/{notificationId} {
      allow read: if request.auth.uid == resource.data.userId;
      allow write: if isSignedIn();
    }
    
    // Top-level messages collection (for backward compatibility)
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }
    
    // Marketplace collection
    match /marketplace/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Screen sharing rooms
    match /screening_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
      
      // Chat messages in screening room
      match /chat/{chatId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
    
    // Roleplay characters (both naming conventions for compatibility)
    match /roleplay_characters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    match /roleplayCharacters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Roleplay sessions
    match /roleplay_sessions/{communityId}/sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
      
      // Chat messages in roleplay session
      match /chat/{chatId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
    
    // Test collection (for testing Firebase+Hostinger setup)
    match /test/{testId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // User following/followers subcollections
    match /users/{userId}/following/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    match /users/{userId}/followers/{followerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // User notifications subcollection
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
    
    // Reserved usernames collection
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
                     request.auth.uid == request.resource.data.ownerId &&
                     !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      allow update: if false;
    }

    // Community events
    match /community_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // User events (user-specific event participations)
    match /user_events/{userEventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Friend requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && 
                    (resource.data.fromUserId == request.auth.uid || 
                     resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && 
                      request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && 
                      (resource.data.toUserId == request.auth.uid || 
                       resource.data.fromUserId == request.auth.uid);
      // Only the sender (fromUserId) or recipient (toUserId) may delete.
      // resource != null guard prevents a null-pointer error in rules evaluation
      // if the document doesn't exist (which would produce a spurious permissions error).
      allow delete: if isSignedIn() && 
                      resource != null &&
                      (resource.data.fromUserId == request.auth.uid || 
                       resource.data.toUserId == request.auth.uid);
    }
    
    // Friends collection (user's friends list)
    match /users/{userId}/friends/{friendId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && 
                     (request.auth.uid == userId || 
                      request.auth.uid == friendId);
    }
    
    // Blocked users collection
    match /users/{userId}/blocked/{blockedUserId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Global Posts collection
    match /posts/{postId} {
      allow read: if true; // Public social content
      // Struck/banned users cannot post
      allow create: if canWrite() && request.resource.data.authorId == request.auth.uid;
      // Author can edit; staff can moderate (hide/disable/feature)
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                     || isAdmin()
                     || (resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
                     // Any signed-in user can toggle likes
                     || (isSignedIn()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['likes', 'likedBy']));
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid)
                     || isAdmin()
                     || (resource.data.communityId != null && isCommunityStaff(resource.data.communityId));
      
      // Comments on posts
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if canWrite();
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // Stories collection
    match /stories/{storyId} {
      allow read: if true; // Public social content
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    // Polls collection
    match /polls/{pollId} {
      allow read: if true; // Public social content
      allow create: if canWrite() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Poll votes subcollection
      match /votes/{voteId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
    
    // Quizzes collection
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Quiz attempts subcollection
      match /attempts/{attemptId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
    
    // Questions collection
    match /questions/{questionId} {
      allow read: if true; // Public social content
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Answers to questions
      match /answers/{answerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
    
    // Community Private Chats
    match /community_private_chats/{chatId} {
      // Allow read if user is authenticated and either:
      // 1. The document doesn't exist yet (checking for existence), OR
      // 2. User is a participant in the chat
      allow read: if isSignedIn() && 
                    (!exists(/databases/$(database)/documents/community_private_chats/$(chatId)) ||
                     request.auth.uid in resource.data.participants);
      
      // Allow create if user is authenticated and user is one of the participants
      allow create: if isSignedIn() && 
                      request.auth.uid in request.resource.data.participants;
      
      // Allow update if user is a participant (for updating last message, unread count, etc.)
      allow update: if isSignedIn() && 
                      (request.auth.uid in resource.data.participants);
      
      // Private chat messages subcollection
      match /messages/{messageId} {
        // Allow read if user is authenticated (chat-level security handled by parent)
        allow read: if isSignedIn();
        
        // Allow create if user is the sender and authenticated
        allow create: if isSignedIn() && 
                        request.resource.data.senderId == request.auth.uid;
        
        // Allow update if user is the sender (for editing/deleting own messages)
        allow update: if isSignedIn() && 
                        resource.data.senderId == request.auth.uid;
        
        // Allow delete if user is the sender
        allow delete: if isSignedIn() && 
                        resource.data.senderId == request.auth.uid;
      }
    }
    
    // =============================================================================
    // MARKETPLACE SECURITY - CRITICAL
    // =============================================================================
    
    // Products - Read-only for clients, managed by Cloud Functions
    match /products/{productId} {
      // Any signed-in user can read/list products (client filters by status)
      allow read: if isSignedIn();
      
      // Sellers can create/update their own products; admins can manage all
      allow create: if isSignedIn() &&
                      request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin()
                    );
      allow delete: if isSignedIn() && (
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin()
                    );
    }
    
    // Orders - Users can read their own orders, Cloud Functions create them
    match /orders/{orderId} {
      // Users can only read their own orders
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Orders can only be created by Cloud Functions (not directly by clients)
      allow create, update, delete: if false;
    }
    
    // Libraries - Users can read their own library, Cloud Functions modify it
    match /libraries/{userId} {
      // Users can only read their own library
      allow read: if isSignedIn() && isOwner(userId);
      
      // Allow Cloud Functions and client to write library (purchases update it)
      allow create, update: if isSignedIn() && isOwner(userId);
      allow delete: if isAdmin();
    }
    
    // IAP Transactions - Cloud Functions only
    match /iap_transactions/{transactionId} {
      // Users can read their own IAP transactions
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // IAP transactions can only be created by Cloud Functions
      allow create, update, delete: if false;
    }
    
    // Product Reviews (Optional feature)
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Users can create reviews for products they own
      allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.productId != null;
      
      // Users can update/delete their own reviews
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

  }
}
