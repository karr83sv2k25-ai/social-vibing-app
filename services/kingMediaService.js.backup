//================================
// ENHANCED FETCH FOR REACT NATIVE
//================================
const fetchWithConfig = async (url, options = {}, timeout = 30000) => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeout);

    try {
        const response = await fetch(url, {
            ...options,
            signal: controller.signal,
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                ...options.headers,
            },
            // Critical for React Native
            credentials: 'omit',
            mode: 'cors',
        });

        clearTimeout(timeoutId);
        return response;
    } catch (error) {
        clearTimeout(timeoutId);
        if (error.name === 'AbortError') {
            throw new Error('Request timeout');
        }
        throw error;
    }
};

//================================
// MOCK DATA GENERATORS
//================================
const generateMockImage = (prompt, provider) => {
    // Extract keywords from prompt to generate unique seed
    const keywords = prompt
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, '')
        .split(' ')
        .filter(word => word.length > 3)
        .slice(0, 3)
        .join('-');

    const timestamp = Date.now();
    const randomId = Math.floor(Math.random() * 10000);

    // Use Picsum (Lorem Picsum) - more reliable than Unsplash
    const seed = `${keywords || 'image'}-${randomId}`;
    const imageUrl = `https://picsum.photos/seed/${seed}/512/512?t=${timestamp}`;

    console.log(`✅ Generated image for "${prompt}"`);
    console.log(`   Seed: ${seed}`);

    return {
        success: true,
        image_url: imageUrl,
        provider: provider,
        prompt: prompt,
        timestamp: new Date().toISOString()
    };
};

const generateMockAIResponse = (question, provider) => {
    const responses = [
        `Here's my response about "${question.slice(0, 30)}..." - This is a mock answer for testing.`,
        `Based on your question regarding "${question.slice(0, 30)}...", I can provide this test response.`,
        `Regarding "${question.slice(0, 30)}..." - This is a simulated AI response for development purposes.`
    ];

    return {
        success: true,
        answer: responses[Math.floor(Math.random() * responses.length)],
        provider: provider,
        tokens_used: Math.floor(Math.random() * 200) + 50
    };
};

const generateMockVideo = (prompt, provider) => {
    const jobId = Math.floor(Math.random() * 10000) + 1000;
    const createdAt = Date.now();

    // Store job info with creation time
    MOCK_VIDEO_JOBS.set(jobId, {
        jobId,
        prompt,
        provider,
        status: 'processing',
        createdAt,
        videoUrl: null
    });

    // Set timeout to mark job as completed after 10 seconds (simulating video processing)
    setTimeout(() => {
        const job = MOCK_VIDEO_JOBS.get(jobId);
        if (job) {
            // Select video based on prompt keywords
            const promptLower = job.prompt.toLowerCase();
            let videoUrl;

            if (promptLower.includes('nature') || promptLower.includes('ocean') || promptLower.includes('water') || promptLower.includes('sea')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4';
            } else if (promptLower.includes('flower') || promptLower.includes('spring') || promptLower.includes('garden')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4';
            } else if (promptLower.includes('fun') || promptLower.includes('play') || promptLower.includes('happy') || promptLower.includes('animal')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4';
            } else if (promptLower.includes('joy') || promptLower.includes('laugh') || promptLower.includes('smile')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerJoyrides.mp4';
            } else if (promptLower.includes('wonder') || promptLower.includes('magic') || promptLower.includes('amazing')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerMeltdowns.mp4';
            } else if (promptLower.includes('elephant') || promptLower.includes('dream') || promptLower.includes('story')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4';
            } else if (promptLower.includes('sintel') || promptLower.includes('dragon') || promptLower.includes('adventure')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/Sintel.mp4';
            } else if (promptLower.includes('gear') || promptLower.includes('tech') || promptLower.includes('subaru')) {
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/SubaruOutbackOnStreetAndDirt.mp4';
            } else {
                // Default to Big Buck Bunny for generic prompts
                videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';
            }

            job.status = 'completed';
            job.videoUrl = videoUrl;
            MOCK_VIDEO_JOBS.set(jobId, job);
            console.log(`✅ Mock video job ${jobId} completed with contextual video`);
            console.log(`   Prompt: "${job.prompt}"`);
            console.log(`   Video: ${videoUrl}`);
        }
    }, 10000); // Complete after 10 seconds

    return {
        success: true,
        job_id: jobId,
        message: `Video generation started for: "${prompt.slice(0, 30)}..."`,
        prompt: prompt,
        provider: provider,
        status: 'processing'
    };
};

const getMockJobStatus = (jobId) => {
    const job = MOCK_VIDEO_JOBS.get(parseInt(jobId));

    if (!job) {
        return {
            success: false,
            message: 'Job not found'
        };
    }

    const response = {
        success: true,
        job: {
            id: job.jobId,
            status: job.status,
            prompt: job.prompt,
            provider: job.provider,
            created_at: new Date(job.createdAt).toISOString()
        }
    };

    if (job.status === 'completed' && job.videoUrl) {
        response.job.video_url = job.videoUrl;
        console.log(`✅ Job ${jobId} is completed with video URL`);
    } else {
        console.log(`⏳ Job ${jobId} is still processing...`);
    }

    return response;
};

