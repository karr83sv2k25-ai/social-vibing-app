//================================
// UTILITY: Fetch-based API call
//================================
const fetchAPI = async (endpoint, options = {}) => {
    const url = `${API_URL}${endpoint}`;
    const token = await AsyncStorage.getItem('kingmedia_jwt_token');

    // Mock mode for development OR auto-fallback after API failure
    if (MOCK_MODE || AUTO_MOCK_FALLBACK) {
        console.log(`🎭 ${AUTO_MOCK_FALLBACK ? 'AUTO-FALLBACK' : 'MOCK'} MODE: ${options.method || 'GET'} ${endpoint}`);
        console.log(`📝 Request body:`, options.body);
        await new Promise(resolve => setTimeout(resolve, 800)); // Simulate network delay

        if (endpoint === '/auth/login') return MOCK_RESPONSES.login;
        if (endpoint === '/auth/me') return MOCK_RESPONSES.me;

        // Dynamic mock responses based on request body
        if (endpoint === '/ai/ask') {
            const { question, provider } = options.body || {};
            return generateMockAIResponse(question, provider);
        }

        if (endpoint === '/ai/generate') {
            const { prompt, provider } = options.body || {};
            console.log(`🎨 Generating image for: "${prompt}" with ${provider}`);
            return generateMockImage(prompt, provider);
        }

        if (endpoint === '/ai/video') {
            const { prompt, provider } = options.body || {};
            console.log(`🎬 Generating video for: "${prompt}" with ${provider}`);
            return generateMockVideo(prompt, provider);
        }

        // Handle job status endpoint
        if (endpoint.startsWith('/ai/jobs/')) {
            const jobId = endpoint.split('/').pop();
            console.log(`📊 Checking job status for: ${jobId}`);
            return getMockJobStatus(jobId);
        }

        return { success: true, message: 'Mock response' };
    }

    const config = {
        method: options.method || 'GET',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            ...(token && { 'Authorization': `Bearer ${token}` }),
            ...options.headers,
        },
    };

    if (options.body) {
        config.body = JSON.stringify(options.body);
    }

    try {
        console.log(`📡 ${config.method} ${url}`);

        const response = await fetch(url, config);

        // Check for 404 - API endpoint doesn't exist
        if (response.status === 404) {
            console.log(`⚠️ API endpoint not found (404), enabling auto-fallback to mock mode`);
            AUTO_MOCK_FALLBACK = true;
            return fetchAPI(endpoint, options); // Retry with mock mode
        }

        const data = await response.json();
        console.log(`✅ Response ${response.status}:`, data);

        if (!response.ok) {
            throw {
                response: {
                    status: response.status,
                    data: data
                },
                message: data.message || 'Request failed'
            };
        }

        return data;
    } catch (error) {
        console.error(`❌ API Error:`, error);

        // Detailed error diagnostics
        console.log('🔍 Error Diagnostics:', {
            message: error.message,
            name: error.name,
            url: url,
            hasNetwork: typeof navigator !== 'undefined' && navigator.onLine !== false,
            timestamp: new Date().toISOString()
        });

        // Auto-fallback to mock mode on network errors
        if (error.message && (
            error.message.includes('Network request failed') ||
            error.message.includes('Failed to fetch') ||
            error.message.includes('timeout') ||
            error.name === 'TypeError'
        )) {
            if (!AUTO_MOCK_FALLBACK) {
                console.log(`🔄 Network error detected, automatically switching to mock mode`);
                console.log(`📍 This usually happens when:`);
                console.log(`   - Using emulator (10.0.2.2 routing issues)`);
                console.log(`   - Firewall blocking the connection`);
                console.log(`   - API server unreachable from device`);
                console.log(`💡 Try: Physical device on same WiFi or use mock mode`);
                AUTO_MOCK_FALLBACK = true;
                return fetchAPI(endpoint, options); // Retry with mock mode
            }
        }

        throw error;
    }
};

//================================
// AUTH APIs
//================================

export const authAPI = {
    login: async (email, password) => {
        const data = await fetchAPI('/auth/login', {
            method: 'POST',
            body: { email, password }
        });

        if (data.success && data.token) {
            await AsyncStorage.setItem('kingmedia_jwt_token', data.token);
            console.log('💾 Token saved');
        }

        return data;
    },

    me: async () => {
        return await fetchAPI('/auth/me');
    },

    logout: async () => {
        try {
            await fetchAPI('/auth/logout', { method: 'POST' });
        } finally {
            await AsyncStorage.removeItem('kingmedia_jwt_token');
        }
    },
};

//================================
// AI APIs
//================================

export const aiAPI = {
    ask: async (question, provider = 'kingai') => {
        return await fetchAPI('/ai/ask', {
            method: 'POST',
            body: { question, provider }
        });
    },

    generateImage: async (prompt, provider = 'dalle') => {
        return await fetchAPI('/ai/generate', {
            method: 'POST',
            body: { prompt, provider }
        });
    },

    generateVideo: async (prompt, provider = 'veo') => {
        return await fetchAPI('/ai/video', {
            method: 'POST',
            body: { prompt, provider }
        });
    },

    generateThumbnail: async (videoUrl) => {
        return await fetchAPI('/ai/thumbnail', {
            method: 'POST',
            body: { video_url: videoUrl }
        });
    },

    getJob: async (id) => {
        return await fetchAPI(`/ai/jobs/${id}`);
    },

    listJobs: async () => {
        return await fetchAPI('/ai/jobs');
    },
};

//================================
// UTILITIES
//================================

export const getAdminURL = () => ADMIN_URL;

export const getRateLimitInfo = (error) => {
    if (error.response?.status === 429) {
        const retryAfter = error.response?.data?.retry_after || 0;
        const minutes = Math.ceil(retryAfter / 60);
        return {
            limited: true,
            retryAfter,
            message: `Rate limit exceeded. Try again in ${minutes} minute${minutes !== 1 ? 's' : ''}.`,
        };
    }
    return { limited: false };
};

export const formatError = (error) => {
    return error.response?.data?.message || error.message || 'Something went wrong';
};
