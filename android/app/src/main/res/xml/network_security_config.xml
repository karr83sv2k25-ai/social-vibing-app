<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow all connections including cleartext for development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- King Media API - Allow HTTPS with custom certificates -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">beige-crane-665569.hostingersite.com</domain>
        <domain includeSubdomains="true">hostingersite.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    
    <!-- Allow localhost for development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
