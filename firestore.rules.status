// Firebase Firestore Security Rules for User Status System
// Add these rules to your firestore.rules file

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - status fields
    match /users/{userId} {
      // Anyone can read user profiles and status
      allow read: if true;
      
      // Users can only update their own status fields
      allow update: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['currentStatus', 'customStatuses', 'statusUpdatedAt']);
      
      // Users can create their own profile
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own profile
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Other existing rules...
    // Keep your existing rules for posts, communities, messages, etc.
  }
}
